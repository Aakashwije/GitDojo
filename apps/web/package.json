{
  "name": "@gitdojo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-monaco.mjs && next dev",
    "build": "node scripts/copy-monaco.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run lib/account-progress/postgres.db.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/migrate.mjs",
    "perf": "vitest run --config vitest.perf.config.ts",
    "perf:browser": "playwright test --config playwright.perf.config.ts"
  },
  "dependencies": {
    "@asgardeo/nextjs": "0.3.36",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@gitdojo/challenge-engine": "workspace:*",
    "@gitdojo/command-parser": "workspace:*",
    "@gitdojo/error-engine": "workspace:*",
    "@gitdojo/git-engine": "workspace:*",
    "@gitdojo/hints": "workspace:*",
    "@gitdojo/lesson-engine": "workspace:*",
    "@gitdojo/progress": "workspace:*",
    "@gitdojo/repository-state": "workspace:*",
    "@gitdojo/shared-types": "workspace:*",
    "@gitdojo/ui": "workspace:*",
    "@gitdojo/validator": "workspace:*",
    "@monaco-editor/react": "4.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.49.0",
    "monaco-editor": "0.57.0",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@gitdojo/config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
