# GitDojo accounts (optional). Copy to apps/web/.env.local and fill in your own values.
# Without these, GitDojo runs fully without accounts: lessons, challenges, the playground and the
# local progress dashboard all work, and the sign-in pages explain that accounts are unavailable.
# Setup guide: docs/authentication.md
#
# Never commit real values. .env.local is git-ignored.

# Your WSO2 Identity Platform organization's base URL (Console → your application → Info).
NEXT_PUBLIC_ASGARDEO_BASE_URL="https://api.asgardeo.io/t/<your-organization-name>"

# The application's client ID (Console → Applications → your application → Protocol).
NEXT_PUBLIC_ASGARDEO_CLIENT_ID="<your-client-id>"

# The application's client secret. Server-side only: never prefix it with NEXT_PUBLIC_.
ASGARDEO_CLIENT_SECRET="<your-client-secret>"

# Signs GitDojo's session cookie. Required in production (at least 32 characters).
# Generate one with: openssl rand -base64 32
ASGARDEO_SECRET="<a-long-random-string>"

# Optional: set to "disabled" when self-registration is turned off in your organization, so the
# sign-up page says registration is closed instead of sending people to a sign-in page they
# cannot register from.
# GITDOJO_SELF_REGISTRATION="disabled"

# Optional: session cookie lifetime in seconds (default 86400, 24 hours).
# ASGARDEO_SESSION_COOKIE_EXPIRY_TIME="86400"

# Account progress (optional). PostgreSQL 13 or later; server-side only, never prefix it with
# NEXT_PUBLIC_. Without it, signed-in learners get 503 from /api/progress and everything else,
# including anonymous progress in the browser, works as before. Apply the schema with
# `pnpm db:migrate`. Setup guide: docs/account-progress.md
# DATABASE_URL="postgres://<user>:<password>@localhost:5432/gitdojo"

# Optional: a direct (non-pooled) connection for `pnpm db:migrate`, e.g. Neon's URL without
# "-pooler". The app itself always uses DATABASE_URL. Deployment guide: docs/deployment.md
# DATABASE_URL_UNPOOLED="postgres://<owner>:<password>@<host>/<database>?sslmode=verify-full"

# Optional: maximum database connections per server instance (1-20, default 5).
# DATABASE_POOL_MAX="5"
